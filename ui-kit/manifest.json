{
  "$schema": "https://fusion.ipor.io/ui-kit/schema/v1",
  "name": "Fusion UI Kit",
  "version": "1.0.0",
  "purpose": "Canonical source of truth for IPOR Fusion UI elements across homepage, app and prototypes.",
  "updated": "2026-07-08",
  "source": { "tool": "Figma", "fileKey": "uLFQVtx9kmqAyYWCk6KdzC", "page": "IPOR" },

  "consumption": {
    "model": "reimplement",
    "runtimeLibrary": false,
    "summary": "This is a DESIGN SPECIFICATION to reimplement (or vendor in) in your target stack — HTML/CSS, React, Astro, etc. It is NOT a runtime component library.",
    "doNot": [
      "Do NOT expect a loader <script>, a custom element (e.g. <fusion-deposit>), an init() function, or any embed/mount API — none exist.",
      "Do NOT add fusionecosystem.xyz to your site's CSP or load assets from it at runtime.",
      "Do NOT treat the deposit area as a functional widget — it is presentational only (no input handling, wallet-connect, or vault/chain config)."
    ],
    "howTo": [
      "Read `tokens` for colors, gradients, radii and typography.",
      "For each component read `states` for the exact per-state visual spec and `html` for copy-paste markup.",
      "Copy or <link> fusion-ui.css for the styles (classes are prefixed .uk-c-*, driven by a data-state attribute).",
      "Provide your own 26px token icon and wire real behavior (input, MAX, wallet) in your app — the kit only defines appearance."
    ]
  },

  "distribution": {
    "page":     "https://fusionecosystem.xyz/ui-kit",
    "manifest": "https://fusionecosystem.xyz/ui-kit/manifest.json",
    "css":      "https://fusionecosystem.xyz/ui-kit/fusion-ui.css",
    "llms":     "https://fusionecosystem.xyz/llms.txt",
    "rawFallback": {
      "note": "If fusionecosystem.xyz is blocked by your environment's network allowlist, fetch the identical files from GitHub raw (the host this project already uses for live data).",
      "manifest": "https://raw.githubusercontent.com/maderaz/fusionstats/claude/morpho-vault-demand-tracker-Zp6AV/ui-kit/manifest.json",
      "css":      "https://raw.githubusercontent.com/maderaz/fusionstats/claude/morpho-vault-demand-tracker-Zp6AV/ui-kit/fusion-ui.css"
    }
  },

  "domSchema": {
    "article[data-component]": "component family",
    "article[data-variant]": "variant within the family",
    "article[data-figma]": "source Figma node id",
    "[data-state]": "the state a rendered instance shows",
    "[data-token]": "design-token name a value maps to"
  },

